---
import { Image } from "astro:assets";
import logo from "../assets/images/logos/mmg_official_logo.png";

const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: "", label: "Home" },
  { href: "about", label: "About Us" },
  { href: "research-themes", label: "Research Themes" },
  { href: "activities", label: "Activities" },
  { href: "publications", label: "Publications" },
  { href: "collaborators", label: "Collaborators" },
  { href: "news", label: "News" },
];

const currentPath = Astro.url.pathname;
---

<header>
  <div class="header-inner">
    <a href={base} class="brand">
      <Image src={logo} alt="Materials Modelling Group logo" width={40} height={40} />
      <span>Materials Modelling Group</span>
    </a>

    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
    </button>

    <button
      id="nav-toggle"
      class="nav-toggle-btn"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      aria-label="Toggle navigation"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <nav id="primary-nav">
      <ul>
        {navLinks.map((link) => {
          const fullHref = `${base}${link.href}`;
          const isActive =
            link.href === ""
              ? currentPath === base
              : currentPath.startsWith(fullHref);
          return (
            <li>
              <a href={fullHref} aria-current={isActive ? "page" : undefined}>
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  header {
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--space-sm) var(--space-md);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    color: var(--text-strong);
    font-weight: 600;
    font-size: 1.1rem;
  }

  .brand:hover {
    color: var(--text-strong);
    text-decoration: none;
  }

  .brand img {
    border-radius: 6px;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--space-md);
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--text);
    font-weight: 500;
    padding: 0.25rem 0;
    border-bottom: 2px solid transparent;
  }

  nav a:hover {
    color: var(--link-hover);
    text-decoration: none;
  }

  nav a[aria-current="page"] {
    color: var(--link);
    border-bottom-color: var(--accent);
  }

  /* Mobile toggle — real button, state tracked via aria-expanded */
  .nav-toggle-btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 28px;
    height: 22px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }

  .nav-toggle-btn span {
    display: block;
    height: 2px;
    background-color: var(--text-strong);
    border-radius: 1px;
  }

  @media (max-width: 700px) {
    .nav-toggle-btn {
      display: flex;
    }

    nav {
      flex-basis: 100%;
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.2s ease;
    }

    nav ul {
      flex-direction: column;
      gap: var(--space-sm);
      padding: var(--space-sm) 0 0;
    }

    .nav-toggle-btn[aria-expanded="true"] ~ nav {
      max-height: 500px;
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("theme-toggle");
    if (!btn) return;
    btn.addEventListener("click", function () {
      var current = document.documentElement.getAttribute("data-theme");
      var next = current === "dark" ? "light" : "dark";
      document.documentElement.setAttribute("data-theme", next);
      localStorage.setItem("theme", next);
    });
  })();

  (function () {
    var navBtn = document.getElementById("nav-toggle");
    if (!navBtn) return;
    navBtn.addEventListener("click", function () {
      var expanded = navBtn.getAttribute("aria-expanded") === "true";
      navBtn.setAttribute("aria-expanded", String(!expanded));
    });
  })();
</script>
